GOOGLE_API_KEY=your-gemini-api-key-here

# Qdrant: for local Docker use the default below; for Qdrant Cloud, use your
# cluster URL (https://xxxx.cloud.qdrant.io) and set QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Only needed by app.py (Streamlit) if not using .streamlit/secrets.toml
API_BASE_URL=http://localhost:8000

